{
  "name": "dxvk",
  "version": "3.0",
  "port-version": 4,
  "description": "A Vulkan-based translation layer for Direct3D 8/9/10/11 (LibreSAGE fork).",
  "homepage": "https://github.com/LibreSAGE/dxvk",
  "license": "Zlib",
  "dependencies": [
    "spirv-headers",
    {
      "name": "vcpkg-tool-meson",
      "host": true
    },
    "vulkan-headers"
  ],
  "default-features": [
    "d3d10",
    "d3d11",
    "d3d8",
    "d3d9",
    "dxgi"
  ],
  "features": {
    "d3d10": {
      "description": "Build the Direct3D 10 implementation",
      "dependencies": [
        {
          "name": "dxvk",
          "features": [
            "d3d11"
          ]
        }
      ]
    },
    "d3d11": {
      "description": "Build the Direct3D 11 implementation",
      "dependencies": [
        {
          "name": "dxvk",
          "features": [
            "dxgi"
          ]
        }
      ]
    },
    "d3d8": {
      "description": "Build the Direct3D 8 implementation",
      "dependencies": [
        {
          "name": "dxvk",
          "features": [
            "d3d9"
          ]
        }
      ]
    },
    "d3d9": {
      "description": "Build the Direct3D 9 implementation"
    },
    "dxgi": {
      "description": "Build the DXGI implementation"
    },
    "glfw": {
      "description": "Enable the GLFW window system integration (DXVK Native)",
      "dependencies": [
        "glfw3"
      ]
    },
    "sdl2": {
      "description": "Enable the SDL2 window system integration (DXVK Native)",
      "dependencies": [
        "sdl2"
      ]
    },
    "sdl3": {
      "description": "Enable the SDL3 window system integration (DXVK Native)",
      "dependencies": [
        "sdl3"
      ]
    }
  }
}
