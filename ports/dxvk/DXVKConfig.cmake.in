# CMake package configuration for dxvk.
#
# dxvk is built with Meson and only ships pkg-config files upstream; this file
# is generated by the vcpkg port so consumers can use find_package(DXVK CONFIG).
# It exposes one imported target per enabled component, e.g.
#   DXVK::d3d11  DXVK::d3d9  DXVK::dxgi  DXVK::d3d10core  DXVK::d3d8
get_filename_component(_dxvk_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

# Each entry is "<target-suffix>:<library-base-name>".
set(_dxvk_targets "@DXVK_CMAKE_TARGETS@")

foreach(_entry IN LISTS _dxvk_targets)
    string(REPLACE ":" ";" _pair "${_entry}")
    list(GET _pair 0 _tgt)
    list(GET _pair 1 _lib)

    if(TARGET DXVK::${_tgt})
        continue()
    endif()

    find_library(DXVK_${_tgt}_LIBRARY_RELEASE NAMES ${_lib}
        PATHS "${_dxvk_root}/lib" NO_DEFAULT_PATH)
    find_library(DXVK_${_tgt}_LIBRARY_DEBUG NAMES ${_lib}
        PATHS "${_dxvk_root}/debug/lib" NO_DEFAULT_PATH)

    if(NOT DXVK_${_tgt}_LIBRARY_RELEASE AND NOT DXVK_${_tgt}_LIBRARY_DEBUG)
        set(DXVK_FOUND FALSE)
        set(DXVK_NOT_FOUND_MESSAGE "dxvk component '${_tgt}' (${_lib}) was not found")
        return()
    endif()

    add_library(DXVK::${_tgt} UNKNOWN IMPORTED)
    set_target_properties(DXVK::${_tgt} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_dxvk_root}/include/dxvk")

    if(DXVK_${_tgt}_LIBRARY_RELEASE)
        set_property(TARGET DXVK::${_tgt} APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
        set_target_properties(DXVK::${_tgt} PROPERTIES
            IMPORTED_LOCATION_RELEASE "${DXVK_${_tgt}_LIBRARY_RELEASE}"
            IMPORTED_LOCATION "${DXVK_${_tgt}_LIBRARY_RELEASE}")
    endif()
    if(DXVK_${_tgt}_LIBRARY_DEBUG)
        set_property(TARGET DXVK::${_tgt} APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
        set_target_properties(DXVK::${_tgt} PROPERTIES
            IMPORTED_LOCATION_DEBUG "${DXVK_${_tgt}_LIBRARY_DEBUG}")
        if(NOT DXVK_${_tgt}_LIBRARY_RELEASE)
            set_target_properties(DXVK::${_tgt} PROPERTIES
                IMPORTED_LOCATION "${DXVK_${_tgt}_LIBRARY_DEBUG}")
        endif()
    endif()
endforeach()

set(DXVK_FOUND TRUE)
